generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum Role {
  USER
  ADMIN
}

enum SessionType {
  TOURNAMENT
  CASH
}

enum SessionStatus {
  CREATED
  SCHEDULED
  OPEN
  LATE_REG_CLOSED
  CLOSED
  ARCHIVED
}

enum SeriesStatus {
  ACTIVE
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Identity — User is shared between Better Auth and the app
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique @db.Citext
  name          String?
  image         String?
  role          Role     @default(USER)
  emailVerified Boolean  @default(false)
  welcomedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile        Profile?
  player         Player?
  sessionEntries SessionEntry[]
  eloHistory     EloHistory[]
  auditLogs      AuditLog[]     @relation("AuditActor")
  sessions       AuthSession[]
  accounts       Account[]

  @@map("user")
}

model Player {
  id             String         @id @default(cuid())
  userId         String?        @unique
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName    String
  email          String         @unique @db.Citext
  createdAt      DateTime       @default(now())
  sessionEntries SessionEntry[]
  streaks        Streak[]

  @@map("player")
}

// --- Better Auth tables ------------------------------------------------------

model AuthSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Profile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname         String?   @unique @db.Citext
  avatarId         String    @default("spade-ember")
  bankroll         Int       @default(25000)
  elo              Float     @default(1000)
  ratedHands       Int       @default(0)
  settings         Json      @default("{\"sounds\":true,\"fourColourDeck\":false,\"autoMuck\":true}")
  lastDailyBonusAt DateTime?
  chatBannedAt     DateTime?
  suspendedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Series, sessions, session entries, and streaks
// ---------------------------------------------------------------------------

model Series {
  id               String       @id @default(cuid())
  name             String
  status           SeriesStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  closeRequestedAt DateTime?
  closeRequestedBy String?
  startsAt         DateTime
  endsAt           DateTime
  isActive         Boolean      @default(false)

  sessions     Session[]
  streaks      Streak[]
  pointsScheme PointsScheme?
  hallOfFame   HallOfFameEntry[]

  @@map("series")
}

model Session {
  id                String        @id @default(cuid())
  seriesId          String
  series            Series        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  type              SessionType
  date              DateTime
  scheduledStartTime DateTime?
  actualStartTime   DateTime?
  estimatedDuration Float?
  status            SessionStatus @default(CREATED)
  activePlayerCount Int?
  blindSchedule     Json?
  currentBlindLevel Int           @default(0)
  timerStartedAt    DateTime?
  timerPausedAt     DateTime?
  isPaused          Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  code               String
  submissionsOpenAt  DateTime
  submissionsCloseAt DateTime
  entries            SessionEntry[]

  @@unique([seriesId, date, type])
  @@index([seriesId, date])
  @@map("session")
}

model SessionEntry {
  id                  String    @id @default(cuid())
  sessionId           String
  session             Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId            String?
  player              Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  signInTime          DateTime  @default(now())
  signOutTime         DateTime?
  position            Int?
  basePoints          Float?
  floorPoints         Float?
  isDNF               Boolean   @default(false)

  finishingPosition   Int?
  entrantCount        Int?
  points              Int?
  buyInChips          Int?
  cashOutChips        Int?
  netChips            Int?
  voidedAt            DateTime?
  voidedBy            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("session_entry")
}

model Streak {
  id            String  @id @default(cuid())
  playerId      String
  player        Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  seriesId      String
  series        Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  currentStreak Int     @default(0)
  longestStreak Int     @default(0)
  streakBonus   Float   @default(0)

  @@unique([playerId, seriesId])
}

model PointsScheme {
  id       String @id @default(cuid())
  seriesId String @unique
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  scheme   Json
}

model HallOfFameEntry {
  id       String      @id @default(cuid())
  seriesId String
  series   Series      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  board    SessionType
  nickname String
  value    Int

  @@unique([seriesId, board])
}

// ---------------------------------------------------------------------------
// Online play
// ---------------------------------------------------------------------------

model HandRecord {
  id        String   @id @default(cuid())
  tableId   String
  tableName String
  handNo    Int
  players   Json
  winners   Json
  potSize   Int
  board     String
  summary   String
  rated     Boolean
  eloDeltas Json?
  actionLog Json?
  createdAt DateTime @default(now())

  @@index([tableId, handNo])
  @@index([createdAt])
}

model EloHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta       Float
  ratingAfter Float
  handCount   Int
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Ops
// ---------------------------------------------------------------------------

model Announcement {
  id        String   @id @default(cuid())
  message   String
  active    Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value Json
}

model FormulaConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  detail     Json?
  createdAt  DateTime @default(now())
  tdId       String?
  targetType String?
  targetId   String?
  oldValue   String?
  newValue   String?
  timestamp  DateTime @default(now())

  @@index([createdAt])
}

model TdAccount {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
